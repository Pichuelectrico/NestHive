# NestLink — Variables de entorno centralizadas
# Copiar a .env.local (no commitear) o a .env en la raíz para uso local.
# En Docker, NEXT_PUBLIC_* se inyecta como build ARG (ver compose.yml / Dockerfiles).

# Frontend (Next.js) — se incrusta en build, requiere rebuild si cambia
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Puertos (útiles para compose / scripts)
PUERTO_BACK=8000
PUERTO_FRONT=3000

# Simulación backend (hardcodeado a 4.0/seed 42 en app/sim/env.py; env vars opcionales si Antigravity las expone)
# SIM_SPEED_FACTOR=4
# SIM_SEED=42

# Backend CORS (si se parametriza)
# CORS_ORIGINS=http://localhost:3000
